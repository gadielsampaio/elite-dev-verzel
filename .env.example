# Local development examples only; configure your own values in .env.
# Compose interpolates these into DATABASE_URL; use URL-safe development values.
POSTGRES_USER=app
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=app_db

# Generate with: openssl rand -hex 32 (required, no default)
JWT_SECRET=

# Cleveland live API; use mock for offline Cleveland fixtures (no fallback).
CATALOG_PROVIDER=cleveland
