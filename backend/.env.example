# Optional host execution only; Compose supplies DATABASE_URL automatically.
# Example development values only. Match your root .env and existing database.
DATABASE_URL=postgresql://app:dev_password@localhost:5432/app_db?schema=public
# Optional host API port; Compose publishes port 3000.
PORT=3000

# Generate with: openssl rand -hex 32 (required, no default)
JWT_SECRET=

# Cleveland live API; use mock for offline Cleveland fixtures (no fallback).
CATALOG_PROVIDER=cleveland

# Optional additional filesystem witness: ABSOLUTE protected path outside PostgreSQL.
# Leave empty to use the trigger-backed database audit history.
AUDIT_CHECKPOINT_DIR=

# Allowed frontend origins, comma-separated. Set the Vercel origin on Render.
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Local HTTP only. Production defaults to Secure + SameSite=None.
AUTH_COOKIE_SECURE=false
