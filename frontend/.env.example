# Public browser configuration. Never put passwords or JWT secrets in VITE_*.
# Relative /api uses the dev proxy; production must provide a matching reverse proxy,
# or set an absolute backend URL and configure backend CORS for the frontend origin.
VITE_API_BASE_URL=/api

# Only the isolated /preview prototype calls Cleveland directly.
VITE_CATALOG_API_URL=https://openaccess-api.clevelandart.org/api/artworks

# Vite dev-server settings; not exposed to browser code.
API_PROXY_TARGET=http://127.0.0.1:3000
DEV_SERVER_HOST=127.0.0.1
DEV_SERVER_PORT=5175
